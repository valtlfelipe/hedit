{
  "name": "hedit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "set-version": "bun scripts/replace-version.js",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --apply",
    "format": "biome format src",
    "format:write": "biome format src --write"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-store": "~2.4.5",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.56.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
